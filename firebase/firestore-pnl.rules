    // ===== PNL - Phúc Nguyên Library (viết lại 11/11/2026 — khớp mã đang chạy, bỏ toàn bộ quy tắc PNL cũ) =====
    // ĐÃ XUẤT BẢN trong console 11/11/2026 15:11; thêm khối Quản trị 13/11/2026; thêm pnl_tk, pnl_phien 17/11/2026; thêm pnl_nh, pnl_nh_pub 18/11/2026; thêm pnl_kq 24/11/2026; từ 18/11 trang quản trị tự xuất bản khối này (lop/rules-sync.js) (bản cũ: firestore-pnl-cu-0511.rules).
    // Dùng hàm chung isAdmin() và signedIn() ở đầu tệp; không đụng phần PNW, PND.
    // Phiên bản khối quy tắc PNL: trang quản trị đọc thử pnl_rules_v/<phiên bản>; bị chặn = quy tắc trên máy chủ cũ hơn kho GitHub,
    // trang hiện nút "Cập nhật quy tắc" tự thay khối PNL (từ dòng tiêu đề đầu khối đến dòng kết thúc khối) qua Firebase Rules API. Đổi quy tắc thì tăng số này.
    match /pnl_rules_v/{v} { allow get: if v == '20261126b'; }


    // --- Mã lớp ôn tập (trang chủ) ---
    match /pnl_ma/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
      match /luot/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/pnl_ma/$(code));
        allow update, delete: if isAdmin();
      }
    }
    match /pnl_meta/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // Góp ý / báo lỗi: ai cũng xem; mỗi người chỉ ghi vào mục của mình
    match /pnl_gopy/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 40;
      allow delete: if isAdmin();
    }

    // --- Quản trị (13/11/2026): học phần, chương thêm thủ công trên trang quan-tri/ ---
    // Ai cũng đọc được khi đã công bố (pub == true); chỉ quản trị đọc bản ẩn/nháp và ghi.
    match /pnl_hp/{id} {
      allow read: if isAdmin() || resource.data.pub == true;
      allow write: if isAdmin();
    }
    match /pnl_hp_ch/{id} {
      allow read: if isAdmin() || resource.data.pub == true;
      allow write: if isAdmin();
    }
    // Tài liệu, thư mục, liên kết thông dụng (14/11/2026): ai cũng đọc, chỉ quản trị ghi
    match /pnl_docs/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pnl_folders/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pnl_links/{id} { allow read: if true; allow write: if isAdmin(); }

    // --- Đánh giá định kỳ ---
    function pnlLop(ma) {
      return get(/databases/$(database)/documents/pnl_dg_lop/$(ma)).data;
    }
    function pnlMo(l) {
      return l.open == true
        && (!('openAt' in l) || request.time >= l.openAt)
        && (!('closeAt' in l) || request.time <= l.closeAt);
    }
    // Lớp và tên sinh viên: tra được khi biết đúng mã; chỉ quản trị liệt kê và sửa
    match /pnl_dg_lop/{ma} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    match /pnl_dg_sv/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // Danh sách kèm ngày sinh, điểm, khóa đáp án: chỉ quản trị
    match /pnl_dg_ds/{ma} {
      allow read, write: if isAdmin();
    }
    match /pnl_dg_cham/{id} {
      allow read, write: if isAdmin();
    }
    // Đề rút từ Ngân hàng câu hỏi (18/11/2026): đề nguồn không kèm đáp án — ai biết mã lớp đọc được; đáp án chỉ quản trị
    match /pnl_dg_de/{ma} { allow get: if true; allow list, write: if isAdmin(); }
    match /pnl_dg_dap/{ma} { allow read, write: if isAdmin(); }
    // Bài làm: sinh viên tạo một lần khi lớp đang mở, chỉ đọc/sửa bài của chính mình đến giờ đóng + 15 phút
    match /pnl_dg_bai/{baiId} {
      allow get: if resource == null || isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid); // SV xem lịch sử bài của mình (26/11/2026)
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['maLop','mssv','hoTen','uid','status','startedAt','de','hocPhan','roiTrang','essay','answers','step'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'dang-lam'
        && request.resource.data.startedAt == request.time
        && baiId == request.resource.data.maLop + '__' + request.resource.data.mssv
        // 18/11/2026 (h): đề con của lớp (pnl_dg_lop/{lớp-HP}, trường cha = mã lớp) dùng danh sách sinh viên của lớp cha
        && exists(/databases/$(database)/documents/pnl_dg_sv/$(pnlLop(request.resource.data.maLop).get('cha', request.resource.data.maLop) + '__' + request.resource.data.mssv))
        && request.resource.data.hoTen == get(/databases/$(database)/documents/pnl_dg_sv/$(pnlLop(request.resource.data.maLop).get('cha', request.resource.data.maLop) + '__' + request.resource.data.mssv)).data.hoTen
        && request.resource.data.hocPhan == pnlLop(request.resource.data.maLop).hocPhan
        && pnlMo(pnlLop(request.resource.data.maLop))
        // 18/11/2026: chỉ tài khoản lớp đã đăng nhập, đúng mã SV của phiên, mới tạo được bài
        && exists(/databases/$(database)/documents/pnl_phien/$(request.auth.uid))
        && get(/databases/$(database)/documents/pnl_phien/$(request.auth.uid)).data.mssv == request.resource.data.mssv);
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'dang-lam'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','essay','status','submittedAt','roiTrang','luu','step','khoaVi'])
        && request.resource.data.status in ['dang-lam', 'da-nop']
        && (request.resource.data.status == 'dang-lam' || request.resource.data.submittedAt == request.time)
        && request.resource.data.get('essay', '').size() <= 20000
        && request.time <= pnlLop(resource.data.maLop).get('closeAt', request.time) + duration.value(15, 'm'));
    }

    // --- Lớp học / tài khoản sinh viên (17/11/2026, trang lop/) ---
    // Tài khoản: chỉ quản trị đọc/ghi; sinh viên đã đăng nhập (có phiên) đọc được tài khoản của mình
    // và chỉ đổi được mật khẩu của mình (pw, pwDefault, doiLuc).
    function pnlPhien() {
      return get(/databases/$(database)/documents/pnl_phien/$(request.auth.uid)).data;
    }
    function pnlLaChinhMinh(mssv) {
      return signedIn()
        && exists(/databases/$(database)/documents/pnl_phien/$(request.auth.uid))
        && pnlPhien().mssv == mssv
        && pnlPhien().h == resource.data.pw;
    }
    match /pnl_tk/{mssv} {
      allow get: if isAdmin() || pnlLaChinhMinh(mssv);
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (pnlLaChinhMinh(mssv)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pw', 'pwDefault', 'doiLuc'])
        && request.resource.data.pw is string && request.resource.data.pw.size() == 64
        && request.resource.data.pwDefault == false);
    }
    // Phiên đăng nhập sinh viên: mỗi người một tài liệu theo uid; chỉ ghi được khi băm mật khẩu khớp tài khoản
    // (máy chủ đối chiếu, trình duyệt không bao giờ đọc được băm của người khác).
    match /pnl_phien/{uid} {
      allow get, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mssv', 'h', 'at'])
        && request.resource.data.mssv is string && request.resource.data.h is string
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/pnl_tk/$(request.resource.data.mssv))
        && get(/databases/$(database)/documents/pnl_tk/$(request.resource.data.mssv)).data.pw == request.resource.data.h;
    }
    // --- Điểm danh QR, chuyên cần, bảng tin, bài tập (17/11/2026) ---
    function pnlTk() {
      return get(/databases/$(database)/documents/pnl_tk/$(pnlPhien().mssv)).data;
    }
    function pnlSvHopLe() {
      return signedIn()
        && exists(/databases/$(database)/documents/pnl_phien/$(request.auth.uid))
        && pnlPhien().h == pnlTk().pw;
    }
    function pnlSvTrongLop(maLop) {
      return pnlSvHopLe() && maLop in pnlTk().lop;
    }
    function pnlBuoi(id) {
      return get(/databases/$(database)/documents/pnl_dd/$(id)).data;
    }
    match /pnl_dd/{id} {
      allow get, list: if isAdmin() || pnlSvTrongLop(resource.data.maLop);
      allow write: if isAdmin();
    }
    match /pnl_dd_sv/{id} {
      allow get, list: if isAdmin() || (pnlSvHopLe() && resource.data.mssv == pnlPhien().mssv);
      allow write: if isAdmin();
      allow create: if pnlSvHopLe()
        && request.resource.data.mssv == pnlPhien().mssv
        && id == request.resource.data.buoi + '__' + request.resource.data.mssv
        && request.resource.data.keys().hasOnly(['buoi', 'maLop', 'mssv', 'maBuoi', 'luc'])
        && request.resource.data.luc == request.time
        && pnlBuoi(request.resource.data.buoi).maLop == request.resource.data.maLop
        && pnlSvTrongLop(request.resource.data.maLop)
        && pnlBuoi(request.resource.data.buoi).trangThai == 'open'
        && pnlBuoi(request.resource.data.buoi).dongLuc > request.time
        && pnlBuoi(request.resource.data.buoi).maBuoi == request.resource.data.maBuoi;
    }
    match /pnl_cc/{maLop} {
      allow read, write: if isAdmin();
    }
    match /pnl_tin/{id} {
      allow get, list: if isAdmin() || pnlSvTrongLop(resource.data.maLop);
      allow write: if isAdmin();
    }
    match /pnl_bt/{id} {
      allow get, list: if isAdmin() || pnlSvTrongLop(resource.data.maLop);
      allow write: if isAdmin();
    }
    match /pnl_bt_nop/{id} {
      allow get, list: if isAdmin() || (pnlSvHopLe() && resource.data.mssv == pnlPhien().mssv);
      allow delete: if isAdmin();
      allow create, update: if pnlSvHopLe()
        && request.resource.data.mssv == pnlPhien().mssv
        && id == request.resource.data.bt + '__' + request.resource.data.mssv
        && exists(/databases/$(database)/documents/pnl_bt/$(request.resource.data.bt))
        && get(/databases/$(database)/documents/pnl_bt/$(request.resource.data.bt)).data.maLop == request.resource.data.maLop
        && pnlSvTrongLop(request.resource.data.maLop);
    }
    // --- Ngân hàng câu hỏi (18/11/2026): kho kín chỉ quản trị; bản xuất bản cho web ôn tập ai cũng đọc ---
    match /pnl_nh/{id} { allow read, write: if isAdmin(); }
    // Đề kiểm tra gốc trong Ngân hàng câu hỏi (kèm đáp án) — chỉ quản trị; bản phát hành cho từng đợt ở pnl_dg_de / pnl_dg_dap
    match /pnl_nh_de/{id} { allow read, write: if isAdmin(); }
    match /pnl_nh_pub/{hp} { allow read: if true; allow write: if isAdmin(); }
    // --- Kết quả học tập công bố cho sinh viên (24/11/2026): quản trị ghi khi mở Bảng điểm; sinh viên chỉ đọc điểm của chính mình ---
    match /pnl_kq/{id} {
      allow get, list: if isAdmin() || (pnlSvHopLe() && resource.data.mssv == pnlPhien().mssv);
      allow write: if isAdmin();
    }
    // --- Nhật ký hoạt động sinh viên (26/11/2026): SV tự ghi việc của mình (giờ máy chủ), không sửa/xóa; SV đọc của mình, quản trị đọc tất cả ---
    match /pnl_nk/{id} {
      allow create: if pnlSvHopLe()
        && request.resource.data.mssv == pnlPhien().mssv
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.luc == request.time
        && request.resource.data.keys().hasOnly(['mssv','uid','lop','loai','ngay','tb','luc','dot','hp','nd','diem'])
        && request.resource.data.loai is string && request.resource.data.loai.size() < 30
        && request.resource.data.lop is list && request.resource.data.lop.size() <= 10
        && (!('nd' in request.resource.data) || request.resource.data.nd.size() <= 400);
      allow get, list: if isAdmin() || (pnlSvHopLe() && resource.data.mssv == pnlPhien().mssv);
      allow update, delete: if isAdmin();
    }
    // Hết khối PNL
