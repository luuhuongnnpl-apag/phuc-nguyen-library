    // ===== PNL - Phúc Nguyên Library (viết lại 11/11/2026 — khớp mã đang chạy, bỏ toàn bộ quy tắc PNL cũ) =====
    // ĐÃ XUẤT BẢN trong console 11/11/2026 15:11; thêm khối Quản trị 13/11/2026 (bản cũ: firestore-pnl-cu-0511.rules).
    // Dùng hàm chung isAdmin() và signedIn() ở đầu tệp; không đụng phần PNW, PND.


    // --- Mã lớp ôn tập (trang chủ) ---
    match /pnl_ma/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
      match /luot/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/pnl_ma/$(code));
        allow update, delete: if isAdmin();
      }
    }
    match /pnl_meta/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // Góp ý / báo lỗi: ai cũng xem; mỗi người chỉ ghi vào mục của mình
    match /pnl_gopy/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 40;
      allow delete: if isAdmin();
    }

    // --- Quản trị (13/11/2026): học phần, chương thêm thủ công trên trang quan-tri/ ---
    // Ai cũng đọc được khi đã công bố (pub == true); chỉ quản trị đọc bản ẩn/nháp và ghi.
    match /pnl_hp/{id} {
      allow read: if isAdmin() || resource.data.pub == true;
      allow write: if isAdmin();
    }
    match /pnl_hp_ch/{id} {
      allow read: if isAdmin() || resource.data.pub == true;
      allow write: if isAdmin();
    }
    // Tài liệu, thư mục, liên kết thông dụng (14/11/2026): ai cũng đọc, chỉ quản trị ghi
    match /pnl_docs/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pnl_folders/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pnl_links/{id} { allow read: if true; allow write: if isAdmin(); }

    // --- Đánh giá định kỳ ---
    function pnlLop(ma) {
      return get(/databases/$(database)/documents/pnl_dg_lop/$(ma)).data;
    }
    function pnlMo(l) {
      return l.open == true
        && (!('openAt' in l) || request.time >= l.openAt)
        && (!('closeAt' in l) || request.time <= l.closeAt);
    }
    // Lớp và tên sinh viên: tra được khi biết đúng mã; chỉ quản trị liệt kê và sửa
    match /pnl_dg_lop/{ma} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    match /pnl_dg_sv/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // Danh sách kèm ngày sinh, điểm, khóa đáp án: chỉ quản trị
    match /pnl_dg_ds/{ma} {
      allow read, write: if isAdmin();
    }
    match /pnl_dg_cham/{id} {
      allow read, write: if isAdmin();
    }
    // Bài làm: sinh viên tạo một lần khi lớp đang mở, chỉ đọc/sửa bài của chính mình đến giờ đóng + 15 phút
    match /pnl_dg_bai/{baiId} {
      allow get: if resource == null || isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow list, delete: if isAdmin();
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['maLop','mssv','hoTen','uid','status','startedAt','de','hocPhan','roiTrang','essay','answers','step'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'dang-lam'
        && request.resource.data.startedAt == request.time
        && baiId == request.resource.data.maLop + '__' + request.resource.data.mssv
        && exists(/databases/$(database)/documents/pnl_dg_sv/$(baiId))
        && request.resource.data.hoTen == get(/databases/$(database)/documents/pnl_dg_sv/$(baiId)).data.hoTen
        && request.resource.data.hocPhan == pnlLop(request.resource.data.maLop).hocPhan
        && pnlMo(pnlLop(request.resource.data.maLop)));
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'dang-lam'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','essay','status','submittedAt','roiTrang','luu','step','khoaVi'])
        && request.resource.data.status in ['dang-lam', 'da-nop']
        && (request.resource.data.status == 'dang-lam' || request.resource.data.submittedAt == request.time)
        && request.resource.data.get('essay', '').size() <= 20000
        && request.time <= pnlLop(resource.data.maLop).get('closeAt', request.time) + duration.value(15, 'm'));
    }
    // Hết khối PNL
